flowchart TB
    classDef group fill:#FFF7CC,stroke:#C9A227,stroke-width:1.5px,color:#332B00;
    classDef azure fill:#EAF4FF,stroke:#2B6CB0,stroke-width:1.5px,color:#0F2A43;
    classDef app fill:#E8FFF4,stroke:#1F7A4D,stroke-width:1.5px,color:#103222;
    classDef data fill:#F3ECFF,stroke:#6B46C1,stroke-width:1.5px,color:#2D1B69;
    classDef ops fill:#FFF0F0,stroke:#C53030,stroke-width:1.5px,color:#4A1111;
    classDef scope fill:#EEF8FF,stroke:#2563EB,stroke-width:1.5px,color:#102A43;

    User[Platform and Capacity Team]
    Browser[Browser UI\nReports + Admin + Quota Workbench]

    subgraph Experience[Experience Layer]
        direction LR
        WebApp[Azure App Service\nReact UI + Express API]
        Api[Node API\nCapacity + Quota + AI endpoints]
        Worker[Function App Worker\nPowerShell 7.4]
    end

    subgraph PrivateIngress[Private Ingress]
        direction LR
        FuncDns[Private DNS\nprivatelink.azurewebsites.net]
        FuncPE[Function Private Endpoint\nsubresource: sites]
        StorageDns[Private DNS\nprivatelink blob/queue/table/file]
        StoragePE[Worker Storage Private Endpoints\nblob + queue + table + file]
    end

    subgraph Data[Data Platform]
        direction LR
        Sql[(Azure SQL Database\nSnapshots + settings + history)]
        Seed[Schema + migration scripts]
    end

    subgraph Access[RBAC Scope Hierarchy]
        direction LR
        Mg[Management Groups\nPreferred scope]
        Subs[Descendant subscriptions\nFallback lists]
    end

    subgraph Security[Security and Observability]
        direction LR
        Entra[Microsoft Entra\nSQL auth + Easy Auth tokens]
        Kv[Key Vault\nRBAC secrets]
        Appi[Application Insights]
        Log[Log Analytics]
    end

    subgraph Delivery[Deployment Flow]
        direction LR
        Local[Repo + scripts\nBicep or Terraform]
        Infra[Infra deployment\nWeb + Worker + Data]
    end

    User --> Browser --> WebApp --> Api
    Api -->|Private Link + Easy Auth bearer\nor shared-secret fallback| FuncPE --> Worker
    FuncDns --> FuncPE
    Worker -->|Identity-based host storage| StoragePE
    StorageDns --> StoragePE
    Api -->|Managed identity auth| Sql
    Seed --> Sql
    Entra --> Sql
    WebApp -->|Key Vault Secrets User role| Kv
    Worker -->|Key Vault Secrets User| Kv
    WebApp --> Appi --> Log
    Worker --> Appi
    WebApp -->|Reader + GroupQuota Request Operator| Mg
    Worker -->|Compute Recommendations Role\nCost Management Reader\nBilling Reader| Mg
    Mg --> Subs
    Local --> Infra --> WebApp
    Local --> Infra --> Worker
    Local --> Seed

    class Experience,PrivateIngress,Data,Access,Security,Delivery group;
    class WebApp,Api,Worker app;
    class Sql,Seed data;
    class Entra,Kv,Appi,Log azure;
    class Local,Infra ops;
    class Mg,Subs scope;
